---
import BaseLayout from '../layouts/BaseLayout.astro';
import GymCard from '../components/GymCard.astro';
import SportCard from '../components/SportCard.astro';
import Icon from '../components/Icon.astro';
import { featuredGyms } from '../data/gyms';
import { listSportNames, liveSports, sports } from '../data/sports';
import { site } from '../site';

const liveNames = listSportNames();
const mixedSports = new Set(featuredGyms.map((gym) => gym.sport)).size > 1;
---

<BaseLayout
  title={`${site.name} — Find beginner-friendly ${liveNames} gyms in ${site.city}`}
  description={`Discover beginner-friendly ${liveNames} gyms in Santa Rosa, Laguna. Compare trial prices and contact a gym to book your first session.`}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">{site.tagline}</p>
      <h1 class="hero-title">Your next side quest starts here.</h1>
      <p class="hero-sub">Discover beginner-friendly {liveNames} gyms in Santa Rosa, Laguna.</p>
      <div class="hero-actions">
        {
          liveSports.map((sport) => (
            <a href={`/${sport.slug}`} class="btn btn-accent btn-large">
              Explore {sport.name} Gyms
              <Icon name="arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="sports" class="section" aria-labelledby="sports-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="sports-heading" class="section-title">Explore sports</h2>
        <p class="section-sub">{liveNames} {liveSports.length === 1 ? 'is' : 'are'} live now. More sports are on the way.</p>
      </div>
      <div class="sport-grid">
        {
          sports.map((sport, i) => (
            <SportCard
              name={sport.name}
              blurb={sport.blurb}
              href={sport.live ? `/${sport.slug}` : undefined}
              index={i + 1}
            />
          ))
        }
      </div>
    </div>
  </section>

  {
    featuredGyms.length > 0 && (
      <section class="section section-tint" aria-labelledby="featured-heading">
        <div class="container">
          <div class="section-head section-head-row">
            <div>
              <h2 id="featured-heading" class="section-title">Featured gyms</h2>
              <p class="section-sub">A few places to throw your first jab or kick.</p>
            </div>
            <div class="text-links">
              {
                liveSports.map((sport) => (
                  <a href={`/${sport.slug}`} class="text-link">
                    All {sport.name} gyms
                    <Icon name="arrow" size={16} />
                  </a>
                ))
              }
            </div>
          </div>
          <div class="gym-grid">
            {featuredGyms.map((gym) => <GymCard gym={gym} headingLevel={3} linkLabel="View Details" showSport={mixedSports} />)}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
