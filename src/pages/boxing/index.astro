---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GymCard from '../../components/GymCard.astro';
import Icon from '../../components/Icon.astro';
import { activeGyms } from '../../data/gyms';

const count = activeGyms.length;
---

<BaseLayout
  title="Boxing Gyms in Santa Rosa, Laguna"
  description="Browse boxing gyms in Santa Rosa, Laguna. See trial prices, beginner-friendly gyms, and how to book or contact each gym for your first session."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Boxing · Santa Rosa, Laguna</p>
      <h1 class="page-title">Boxing Gyms in Santa Rosa</h1>
      <p class="page-sub">Pick a gym, check the trial, and reach out to book your first session.</p>

      <form class="search" role="search" data-search-form hidden onsubmit="return false">
        <label for="gym-search" class="search-label">Search by gym name or area</label>
        <div class="search-field">
          <Icon name="search" />
          <input
            id="gym-search"
            type="search"
            name="q"
            placeholder="e.g. Balibago"
            autocomplete="off"
            aria-describedby="search-status"
            data-search-input
          />
        </div>
      </form>
    </div>
  </section>

  <section class="section section-tight" aria-label="Gym listings">
    <div class="container">
      <p id="search-status" class="result-count" aria-live="polite" data-search-status>
        {count} {count === 1 ? 'gym' : 'gyms'}
      </p>

      {
        count > 0 ? (
          <div class="gym-grid" data-gym-list>
            {activeGyms.map((gym) => (
              <GymCard gym={gym} headingLevel={2} linkLabel="View Gym" />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No gyms listed yet</h2>
            <p>We're adding boxing gyms in Santa Rosa now. Check back soon.</p>
          </div>
        )
      }

      <div class="empty-state" data-search-empty hidden>
        <h2>No gyms match that search</h2>
        <p>Try a different gym name or area, or clear the search to see every gym.</p>
        <button type="button" class="btn btn-small btn-outline" data-search-clear>Clear search</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-gym-card]'));

  if (form && input && status && cards.length) {
    form.hidden = false;
    const total = cards.length;
    const plural = (n: number) => `${n} ${n === 1 ? 'gym' : 'gyms'}`;

    const apply = () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? '';
        const match = terms.every((term) => text.includes(term));
        card.hidden = !match;
        if (match) shown++;
      }
      status.textContent = terms.length ? `${plural(shown)} of ${total} match your search` : plural(total);
      if (empty) empty.hidden = shown > 0;
    };

    input.addEventListener('input', apply);
    clear?.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
    apply();
  }
</script>
