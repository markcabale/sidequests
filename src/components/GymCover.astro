---
import type { Gym } from '../data/gyms';
import { getSport } from '../data/sports';

interface Props {
  gym: Gym;
  /** Use "eager" for the main image above the fold. */
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { gym, loading = 'lazy', class: className = '' } = Astro.props;
const sportName = getSport(gym.sport).name;
const initials = gym.name
  .replace(/\(.*?\)/g, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]!.toUpperCase())
  .join('');
---

<div class:list={['cover', className]}>
  {
    gym.image ? (
      <img
        src={gym.image}
        alt={gym.imageAlt ?? `${gym.name} ${sportName} gym`}
        width="800"
        height="500"
        loading={loading}
        decoding="async"
      />
    ) : (
      <div class="cover-fallback" aria-hidden="true">
        <span class="cover-initials">{initials}</span>
        <span class="cover-label">{sportName}</span>
      </div>
    )
  }
</div>
