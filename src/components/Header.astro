---
import { liveSports } from '../data/sports';
import { site } from '../site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (slug: string) => path === `/${slug}` || path.startsWith(`/${slug}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-text">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          liveSports.map((sport) => (
            <li>
              <a href={`/${sport.slug}`} aria-current={isCurrent(sport.slug) ? 'page' : undefined}>
                {sport.name}
              </a>
            </li>
          ))
        }
        <li><a href="/#sports">Explore Sports</a></li>
      </ul>
    </nav>
  </div>
</header>
